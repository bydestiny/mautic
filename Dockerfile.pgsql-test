FROM php:8.4-apache-bookworm AS build

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_PROCESS_TIMEOUT=10000 \
    APACHE_DOCUMENT_ROOT=/var/www/html

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip \
    libicu-dev libzip-dev libpq-dev libonig-dev \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev \
    libwebp-dev libxml2-dev libkrb5-dev libc-client2007e-dev \
    libcurl4-openssl-dev libssl-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j2 \
       intl mbstring mysqli pdo_mysql pdo_pgsql \
       curl zip bcmath sockets exif gd opcache \
    && pecl install imap \
    && docker-php-ext-enable imap \
    && rm -rf /var/lib/apt/lists/*

# Install Composer.
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Install Node.js 24 for Mautic 7.2.1 frontend dependencies.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x -o /tmp/nodesource.sh \
    && bash /tmp/nodesource.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && node --version \
    && npm --version \
    && rm -rf /var/lib/apt/lists/* /tmp/nodesource.sh

WORKDIR /var/www/html
COPY . .

# Install PHP dependencies.
RUN test -f .env || printf 'APP_ENV=prod\nAPP_DEBUG=0\n' > .env \
    && php -d memory_limit=1G /usr/local/bin/composer install \
       --no-interaction --prefer-dist --optimize-autoloader --no-scripts


# Install frontend dependencies and compile Mautic assets.
RUN npm ci \
    && npm run build

# Generate Mautic production CSS and JavaScript assets.
RUN php bin/console sass:build --env=prod --no-interaction \
    && php bin/console mautic:assets:generate --env=prod --no-interaction \
    && php bin/console cache:clear --env=prod --no-interaction


# Runtime image.
FROM php:8.4-apache-bookworm AS runtime

ENV APACHE_DOCUMENT_ROOT=/var/www/html \
    PHP_INI_VALUE_DATE_TIMEZONE=UTC \
    PHP_INI_VALUE_MEMORY_LIMIT=512M \
    PHP_INI_VALUE_MAX_EXECUTION_TIME=300 \
    PHP_INI_VALUE_UPLOAD_MAX_FILESIZE=64M \
    PHP_INI_VALUE_POST_MAX_SIZE=64M

# Configure PHP for Mautic production use.
RUN printf '%s\n' \
    'memory_limit = 512M' \
    'max_execution_time = 300' \
    'upload_max_filesize = 64M' \
    'post_max_size = 64M' \
    'zend.assertions = -1' \
    > /usr/local/etc/php/conf.d/mautic.ini

RUN apt-get update && apt-get install -y --no-install-recommends \
    libicu-dev libzip4 libpq5 libc-client2007e\
    libfreetype6 libjpeg62-turbo libpng16-16 libwebp7 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=build /var/www/html /var/www/html

RUN sed -ri \
      -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
      /etc/apache2/sites-available/*.conf \
    && sed -ri \
      -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' \
      /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf \
    && a2enmod rewrite \
    && mkdir -p \
       /var/www/html/var \
       /var/www/html/config \
       /var/www/html/media \
       /var/www/html/public/assets \
    && chown -R www-data:www-data \
       /var/www/html/var \
       /var/www/html/config \
       /var/www/html/media \
       /var/www/html/public

WORKDIR /var/www/html
EXPOSE 80
